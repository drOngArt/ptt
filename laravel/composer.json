{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/ui": "^4.0",
        "spatie/laravel-html": "^3.0",
        "league/csv": "~7.0",
        "league/fractal": "0.19",
        "doctrine/dbal": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "barryvdh/laravel-ide-helper": "^3.0",
        "codeception/codeception": "^5.0",
        "larastan/larastan": "^3.0",
        "laravel/tinker": "^2.11",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "database",
            "app/Http/Controllers/pttcompetition.php",
            "app/Http/Controllers/pttcompetitionPTT.php",
            "app/Http/Controllers/pttcompetitionW.php"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}